  "nodes": [
    {
      "id": "history_title",
      "type": "text",
      "x": 60,
      "y": 20,
      "width": 2080,
      "height": 140,
      "label": "Paperstream · 从电子计算到 AI · 连续时间线",
      "text": "1946—2026｜16 个里程碑精选。沿箭头阅读，每行从左到右，再沿行间回折线进入下一行。15 条连线只表示时间顺序，不表示直接技术继承。\n从电子通用计算机时代切入；机械计算、计算理论与早期专用计算机不在此简图范围内。肖像仅展示部分相关人物。",
      "paperstreamCard": {
        "kind": "note"
      },
      "paperstreamStyle": {
        "heightMode": "manual"
      }
    },
