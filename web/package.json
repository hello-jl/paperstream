{
  "name": "paperstream-editor",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": { "node": ">=22.18.0" },
  "scripts": {
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview --host 127.0.0.1",
    "test": "node --experimental-strip-types --test src/*.test.ts",
    "test:interop": "python3 scripts/check_python_roundtrip.py",
    "build:dsh": "node ../dsh/build.mjs"
  },
  "dependencies": {
    "@xyflow/react": "12.12.1",
    "elkjs": "0.12.1",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "esbuild": "0.25.12",
    "typescript": "5.9.3",
    "vite": "7.2.4"
  }
}
